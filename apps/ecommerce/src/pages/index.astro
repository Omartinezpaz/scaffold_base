---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content="Hamburger Rapid — Fast Food Gourmet de autor con 10 hamburguesas exclusivas, carne 100% Angus certificada y pan brioche horneado a diario." />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700;9..144,800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      /* Paleta de colores refinada del Sistema de Diseño */
      --primary: #E87722;
      --primary-dark: #C96418;
      --primary-light: #F4A261;
      --secondary: #2B2D42;
      --secondary-dark: #1E202F;
      --accent: #FFD166;
      --success: #06D6A0;
      --danger: #EF476F;

      /* Fondos y superficies */
      --bg-primary: #FAF7F2;
      --bg-secondary: #F3EDE3;
      --surface: #FFFFFF;
      --surface-warm: #FFFDF9;
      --border: #E2E8F0;
      --border-subtle: #F1F5F9;

      /* Colores de texto */
      --text-main: #1E293B;
      --text-secondary: #64748B;
      --text-muted: #94A3B8;

      /* Escala tipográfica mejorada */
      --text-xs: 0.75rem;
      --text-sm: 0.875rem;
      --text-base: 1rem;
      --text-lg: 1.125rem;
      --text-xl: 1.25rem;
      --text-2xl: 1.5rem;
      --text-3xl: 1.875rem;
      --text-4xl: 2.25rem;
      --text-5xl: 3rem;

      /* Espaciado consistente */
      --space-1: 0.25rem;
      --space-2: 0.5rem;
      --space-3: 0.75rem;
      --space-4: 1rem;
      --space-6: 1.5rem;
      --space-8: 2rem;
      --space-12: 3rem;
      --space-16: 4rem;

      /* Sombras mejoradas */
      --shadow-sm: 0 1px 3px 0 rgba(0, 0, 0, 0.06), 0 1px 2px 0 rgba(0, 0, 0, 0.04);
      --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.08), 0 2px 4px -1px rgba(0, 0, 0, 0.04);
      --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -2px rgba(0, 0, 0, 0.04);
      --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);

      /* Bordes */
      --radius-sm: 0.375rem;
      --radius-md: 0.5rem;
      --radius-lg: 0.75rem;
      --radius-xl: 1rem;
      --radius-2xl: 1.5rem;
      --radius-full: 9999px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--bg-primary);
      color: var(--text-main);
      line-height: 1.6;
      overflow-x: hidden;
      -webkit-tap-highlight-color: transparent;
    }

    :focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 3px;
    }

    button:active, .btn-primary:active, .btn-secondary:active, .btn-dark:active, .strip-pill:active, .filter-btn:active {
      transform: scale(0.97) !important;
    }

    .container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 var(--space-6);
    }

    /* Top Announcement Bar */
    .top-bar {
      background: linear-gradient(90deg, #1E202F 0%, var(--secondary) 50%, #1E202F 100%);
      color: #FAF7F2;
      font-size: var(--text-xs);
      font-weight: 600;
      padding: var(--space-2) var(--space-4);
      text-align: center;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: var(--space-4);
      flex-wrap: wrap;
    }
    .top-bar .highlight {
      color: var(--accent);
      font-weight: 700;
    }

    /* Header Navigation */
    header.navbar {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(250, 247, 242, 0.94);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
      padding: var(--space-4) 0;
    }
    .nav-container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      flex-wrap: wrap;
    }
    .brand-logo {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      text-decoration: none;
      color: var(--secondary);
    }
    .brand-icon {
      width: 44px;
      height: 44px;
      border-radius: var(--radius-lg);
      background: linear-gradient(135deg, var(--primary) 0%, #EA580C 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.45rem;
      box-shadow: 0 4px 12px rgba(232, 119, 34, 0.3);
    }
    .brand-text {
      display: flex;
      flex-direction: column;
    }
    .brand-title {
      font-family: 'Fraunces', serif;
      font-size: var(--text-xl);
      font-weight: 800;
      letter-spacing: -0.02em;
      line-height: 1.1;
      color: var(--secondary);
    }
    .brand-sub {
      font-size: var(--text-xs);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--primary);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: var(--space-6);
    }
    .nav-links a {
      text-decoration: none;
      color: var(--text-secondary);
      font-weight: 600;
      font-size: var(--text-sm);
      transition: color 0.25s ease;
      position: relative;
    }
    .nav-links a:hover {
      color: var(--primary);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }

    /* Common Buttons */
    .btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-2);
      padding: var(--space-3) var(--space-6);
      background: linear-gradient(135deg, var(--primary) 0%, #EA580C 100%);
      color: white;
      font-weight: 700;
      font-size: var(--text-base);
      border-radius: var(--radius-lg);
      border: none;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 8px 20px -4px rgba(232, 119, 34, 0.4);
    }
    .btn-primary:hover {
      background: linear-gradient(135deg, var(--primary-dark) 0%, #C96418 100%);
      transform: translateY(-2px);
      box-shadow: 0 14px 24px -4px rgba(232, 119, 34, 0.5);
    }

    .btn-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-2);
      padding: var(--space-3) var(--space-6);
      background: white;
      color: var(--secondary);
      border: 2px solid var(--border);
      border-radius: var(--radius-lg);
      font-weight: 700;
      font-size: var(--text-base);
      cursor: pointer;
      text-decoration: none;
      transition: all 0.3s ease;
      box-shadow: var(--shadow-sm);
    }
    .btn-secondary:hover {
      border-color: var(--primary);
      color: var(--primary);
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    .btn-dark {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-2);
      padding: var(--space-3) var(--space-6);
      background: var(--secondary);
      color: white;
      border: none;
      border-radius: var(--radius-lg);
      font-weight: 700;
      font-size: var(--text-sm);
      cursor: pointer;
      text-decoration: none;
      transition: all 0.3s ease;
    }
    .btn-dark:hover {
      background: #1a1c2e;
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    /* 2. Hero Section Mejorado (Soluciona problema de superposición y jerarquía) */
    .hero-section {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--space-12);
      align-items: center;
      padding: var(--space-12) 0;
      min-height: 75vh;
    }

    .hero-content {
      max-width: 620px;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-2) var(--space-4);
      background: linear-gradient(135deg, rgba(255, 209, 102, 0.28) 0%, rgba(244, 162, 97, 0.22) 100%);
      border: 1px solid rgba(232, 119, 34, 0.3);
      border-radius: var(--radius-xl);
      font-size: var(--text-sm);
      font-weight: 700;
      color: var(--secondary);
      margin-bottom: var(--space-6);
      box-shadow: var(--shadow-sm);
    }

    .hero-title {
      font-family: 'Fraunces', serif;
      font-size: clamp(2.4rem, 4.5vw, var(--text-5xl));
      font-weight: 800;
      line-height: 1.12;
      color: var(--secondary);
      margin-bottom: var(--space-6);
      letter-spacing: -0.02em;
    }

    .hero-title .highlight {
      color: var(--primary);
      position: relative;
      display: inline-block;
      white-space: nowrap;
    }

    .hero-title .highlight::after {
      content: '';
      position: absolute;
      bottom: 6px;
      left: 0;
      width: 100%;
      height: 10px;
      background: var(--accent);
      opacity: 0.4;
      z-index: -1;
      border-radius: var(--radius-sm);
    }

    .hero-description {
      font-size: var(--text-lg);
      line-height: 1.65;
      color: var(--text-secondary);
      margin-bottom: var(--space-8);
    }

    .hero-cta-group {
      display: flex;
      gap: var(--space-4);
      flex-wrap: wrap;
      margin-bottom: var(--space-10);
    }

    .hero-stats {
      display: flex;
      gap: var(--space-10);
      margin-top: var(--space-8);
      padding-top: var(--space-6);
      border-top: 1px solid #E2E8F0;
    }

    .stat-item {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
    }

    .stat-value {
      font-family: 'Fraunces', serif;
      font-size: var(--text-3xl);
      font-weight: 800;
      color: var(--secondary);
    }

    .stat-label {
      font-size: var(--text-sm);
      color: var(--text-secondary);
      font-weight: 600;
    }

    /* Hero Visual Container con ángulo y badge flotante sin colisión */
    .hero-visual {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .hero-image-container {
      position: relative;
      background: white;
      border-radius: var(--radius-2xl);
      padding: var(--space-4);
      box-shadow: var(--shadow-xl);
      transform: rotate(-2.5deg);
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
      width: 100%;
      max-width: 480px;
      border: 1px solid rgba(226, 232, 240, 0.8);
    }

    .hero-image-container:hover {
      transform: rotate(0deg) scale(1.02);
      box-shadow: 0 25px 40px -10px rgba(232, 119, 34, 0.25);
    }

    .hero-image {
      width: 100%;
      height: 380px;
      object-fit: cover;
      border-radius: var(--radius-xl);
      display: block;
    }

    .hero-pill-overlay {
      position: absolute;
      top: 24px;
      left: 24px;
      background: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(8px);
      padding: var(--space-2) var(--space-4);
      border-radius: var(--radius-full);
      font-size: var(--text-xs);
      font-weight: 800;
      color: var(--primary);
      border: 1px solid rgba(232, 119, 34, 0.25);
      box-shadow: var(--shadow-sm);
      z-index: 2;
    }

    /* Badge de premio con animación flotante segura */
    .award-badge {
      position: absolute;
      bottom: -15px;
      right: -15px;
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(12px);
      padding: var(--space-3) var(--space-5);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
      display: flex;
      align-items: center;
      gap: var(--space-3);
      border: 1px solid rgba(226, 232, 240, 0.9);
      animation: float 3s ease-in-out infinite;
      z-index: 5;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
    }

    /* Signature Highlights Bar */
    .signature-strip {
      margin: var(--space-8) 0 var(--space-12);
    }
    .strip-box {
      background: linear-gradient(135deg, #FFFDF9 0%, #FEF5EB 100%);
      border: 1px solid #F3D9B1;
      border-radius: var(--radius-2xl);
      padding: var(--space-6) var(--space-8);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-6);
      flex-wrap: wrap;
      box-shadow: var(--shadow-sm);
    }
    .strip-info h2 {
      font-family: 'Fraunces', serif;
      font-size: var(--text-xl);
      color: var(--secondary);
      margin-bottom: var(--space-1);
    }
    .strip-info p {
      font-size: var(--text-sm);
      color: var(--text-secondary);
    }
    .strip-pills {
      display: flex;
      gap: var(--space-3);
      flex-wrap: wrap;
    }
    .strip-pill {
      background: var(--surface);
      border: 1px solid #E2D5BE;
      padding: var(--space-2) var(--space-4);
      border-radius: var(--radius-lg);
      font-size: var(--text-sm);
      font-weight: 700;
      color: var(--secondary);
      cursor: pointer;
      transition: all 0.25s ease;
      display: flex;
      align-items: center;
      gap: var(--space-2);
    }
    .strip-pill:hover {
      border-color: var(--primary);
      background: rgba(232, 119, 34, 0.08);
      color: var(--primary);
      transform: translateY(-2px);
    }

    /* 3. Cards de Productos Mejoradas (Jerarquía visual, filtros y grid) */
    .catalog-section {
      padding: var(--space-8) 0 var(--space-16);
    }
    .catalog-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      flex-wrap: wrap;
      gap: var(--space-6);
      margin-bottom: var(--space-8);
    }
    .catalog-title-group h2 {
      font-family: 'Fraunces', serif;
      font-size: var(--text-3xl);
      font-weight: 800;
      color: var(--secondary);
      margin-bottom: var(--space-2);
    }
    .catalog-title-group p {
      color: var(--text-secondary);
      font-size: var(--text-base);
    }

    .menu-filters {
      display: flex;
      gap: var(--space-3);
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: var(--space-8);
    }

    .filter-btn {
      padding: var(--space-3) var(--space-6);
      background: white;
      border: 2px solid #E2E8F0;
      border-radius: var(--radius-xl);
      font-weight: 700;
      font-size: var(--text-sm);
      cursor: pointer;
      transition: all 0.25s ease;
      color: var(--text-secondary);
      font-family: inherit;
    }

    .filter-btn:hover {
      border-color: var(--primary);
      color: var(--primary);
    }

    .filter-btn.active {
      background: var(--secondary);
      color: white;
      border-color: var(--secondary);
      box-shadow: var(--shadow-md);
    }

    .products-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: var(--space-8);
    }

    .product-card {
      background: white;
      border-radius: var(--radius-2xl);
      overflow: hidden;
      box-shadow: var(--shadow-md);
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      display: flex;
      flex-direction: column;
      border: 1px solid rgba(226, 232, 240, 0.8);
      position: relative;
    }

    .product-card:hover {
      transform: translateY(-8px);
      box-shadow: var(--shadow-xl);
      border-color: rgba(232, 119, 34, 0.3);
    }

    .product-image-wrapper {
      position: relative;
      height: 240px;
      overflow: hidden;
      background: #F8FAFC;
    }

    .product-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
      display: block;
    }

    .product-card:hover .product-image {
      transform: scale(1.08);
    }

    .product-badges {
      position: absolute;
      top: var(--space-4);
      left: var(--space-4);
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      z-index: 2;
    }

    .badge {
      padding: var(--space-1) var(--space-3);
      border-radius: var(--radius-md);
      font-size: var(--text-xs);
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      box-shadow: var(--shadow-sm);
    }

    .badge-gold {
      background: linear-gradient(135deg, var(--accent) 0%, #F59E0B 100%);
      color: var(--secondary);
    }

    .badge-red {
      background: var(--danger);
      color: white;
    }

    .badge-category {
      background: rgba(255, 255, 255, 0.94);
      color: var(--secondary);
      border: 1px solid rgba(226, 232, 240, 0.8);
    }

    .product-rating {
      position: absolute;
      top: var(--space-4);
      right: var(--space-4);
      background: rgba(30, 32, 47, 0.85);
      color: var(--accent);
      backdrop-filter: blur(6px);
      padding: var(--space-1) var(--space-3);
      border-radius: var(--radius-full);
      font-size: var(--text-xs);
      font-weight: 800;
      display: flex;
      align-items: center;
      gap: var(--space-1);
      z-index: 2;
    }

    .product-price {
      position: absolute;
      bottom: var(--space-4);
      right: var(--space-4);
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(8px);
      padding: var(--space-2) var(--space-4);
      border-radius: var(--radius-lg);
      font-size: var(--text-xl);
      font-weight: 800;
      color: var(--primary);
      box-shadow: var(--shadow-md);
      font-family: 'Fraunces', serif;
      z-index: 2;
      border: 1px solid rgba(226, 232, 240, 0.8);
    }

    .product-content {
      padding: var(--space-6);
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .product-tier-badge {
      display: inline-flex;
      align-items: center;
      gap: var(--space-1);
      font-size: var(--text-xs);
      font-weight: 800;
      padding: var(--space-1) var(--space-3);
      border-radius: var(--radius-md);
      margin-bottom: var(--space-3);
      align-self: flex-start;
    }
    .product-tier-badge.suprema {
      background: #FEF3C7;
      color: #92400E;
      border: 1px solid #FDE68A;
    }
    .product-tier-badge.gourmet {
      background: #EDE9FE;
      color: #5B21B6;
      border: 1px solid #DDD6FE;
    }
    .product-tier-badge.doble {
      background: #FEECE8;
      color: #B82B14;
      border: 1px solid #FECACA;
    }
    .product-tier-badge.especial {
      background: #FFEDD5;
      color: #9A3412;
      border: 1px solid #FED7AA;
    }
    .product-tier-badge.clasica,
    .product-tier-badge.clasica-plus {
      background: #DCFCE7;
      color: #166534;
      border: 1px solid #BBF7D0;
    }

    .product-title {
      font-family: 'Fraunces', serif;
      font-size: var(--text-xl);
      font-weight: 800;
      color: var(--secondary);
      margin-bottom: var(--space-2);
      line-height: 1.25;
    }

    .product-description {
      font-size: var(--text-sm);
      line-height: 1.6;
      color: var(--text-secondary);
      margin-bottom: var(--space-4);
      flex: 1;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .product-tags {
      display: flex;
      gap: var(--space-2);
      margin-bottom: var(--space-4);
      flex-wrap: wrap;
    }

    .tag {
      padding: var(--space-1) var(--space-3);
      background: #F1F5F9;
      border-radius: var(--radius-md);
      font-size: var(--text-xs);
      font-weight: 600;
      color: var(--text-secondary);
    }

    .product-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: var(--space-4);
      padding: var(--space-2) 0;
      border-top: 1px solid var(--border-subtle);
      border-bottom: 1px solid var(--border-subtle);
      font-size: var(--text-xs);
      color: var(--text-secondary);
      font-weight: 600;
    }

    .product-actions {
      display: flex;
      gap: var(--space-3);
    }

    /* 4. Sección PWA Mejorada (Conexión fluida con la App Móvil) */
    .pwa-section {
      background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
      border-radius: var(--radius-2xl);
      padding: var(--space-12) var(--space-8);
      margin: var(--space-12) 0;
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--space-8);
      align-items: center;
      position: relative;
      overflow: hidden;
      box-shadow: var(--shadow-lg);
    }

    .pwa-section::before {
      content: '';
      position: absolute;
      top: -40%;
      right: -10%;
      width: 450px;
      height: 450px;
      background: radial-gradient(circle, rgba(232, 119, 34, 0.22) 0%, transparent 70%);
      border-radius: 50%;
      pointer-events: none;
    }

    .pwa-content {
      position: relative;
      z-index: 1;
    }

    .pwa-label {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      font-size: var(--text-sm);
      font-weight: 800;
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: var(--space-3);
    }

    .pwa-title {
      font-family: 'Fraunces', serif;
      font-size: clamp(1.8rem, 3.5vw, var(--text-4xl));
      font-weight: 800;
      color: var(--secondary);
      line-height: 1.2;
      margin-bottom: var(--space-4);
    }

    .pwa-description {
      font-size: var(--text-base);
      line-height: 1.6;
      color: #475569;
      margin-bottom: var(--space-6);
    }

    .pwa-features {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      margin-bottom: var(--space-8);
    }

    .pwa-feature-item {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: var(--text-sm);
      font-weight: 600;
      color: var(--secondary);
    }

    .pwa-visual {
      position: relative;
      z-index: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: var(--space-6);
    }

    .pwa-icon {
      font-size: 72px;
      animation: bounce 2.2s ease-in-out infinite;
      filter: drop-shadow(0 10px 15px rgba(0,0,0,0.15));
    }

    .pwa-icon:nth-child(2) {
      animation-delay: 0.25s;
    }

    .pwa-icon:nth-child(3) {
      animation-delay: 0.5s;
    }

    @keyframes bounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-16px); }
    }

    /* Experience & Architecture Section */
    .experience-section {
      margin: var(--space-12) 0 var(--space-16);
    }
    .experience-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-2xl);
      padding: var(--space-12);
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--space-8);
      align-items: center;
      box-shadow: var(--shadow-md);
    }
    .exp-features {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-4);
      margin-top: var(--space-6);
    }
    .exp-item {
      background: var(--bg-primary);
      border: 1px solid var(--border-subtle);
      padding: var(--space-4);
      border-radius: var(--radius-lg);
    }
    .exp-item h4 {
      font-size: var(--text-base);
      margin-bottom: var(--space-1);
      color: var(--secondary);
      font-weight: 700;
    }
    .exp-item p {
      font-size: var(--text-sm);
      color: var(--text-secondary);
    }

    /* Interactive Modal Details Overlay */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(30, 32, 47, 0.65);
      backdrop-filter: blur(8px);
      display: none;
      align-items: center;
      justify-content: center;
      padding: var(--space-4);
      z-index: 999;
    }
    .modal-backdrop.open {
      display: flex;
    }
    .modal-box {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-2xl);
      max-width: 680px;
      width: 100%;
      overflow: hidden;
      box-shadow: var(--shadow-xl);
      animation: modalSlide 0.28s cubic-bezier(0.16, 1, 0.3, 1);
      max-height: 90vh;
      display: flex;
      flex-direction: column;
    }
    @keyframes modalSlide {
      from { opacity: 0; transform: translateY(20px) scale(0.96); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .modal-img-wrap {
      position: relative;
      height: 250px;
      background: #F3EDE3;
    }
    .modal-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .modal-close {
      position: absolute;
      top: 16px;
      right: 16px;
      width: 40px;
      height: 40px;
      border-radius: var(--radius-full);
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.96);
      color: var(--secondary);
      font-size: 1.2rem;
      font-weight: 800;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s;
    }
    .modal-close:hover {
      background: #FFFFFF;
      color: var(--primary);
    }
    .modal-content {
      padding: var(--space-6) var(--space-8);
      overflow-y: auto;
    }
    .ingredient-list {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin: var(--space-3) 0 var(--space-5);
    }
    .ingredient-tag {
      background: var(--bg-primary);
      border: 1px solid var(--border);
      padding: var(--space-1) var(--space-3);
      border-radius: var(--radius-full);
      font-size: var(--text-xs);
      font-weight: 700;
      color: var(--secondary);
    }

    /* 5. Footer Compacto y Moderno (Rediseñado según la propuesta) */
    .footer {
      background: var(--secondary);
      color: white;
      padding: var(--space-16) 0 var(--space-8);
      margin-top: var(--space-16);
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: var(--space-12);
      margin-bottom: var(--space-12);
    }

    .footer-brand {
      max-width: 340px;
    }

    .footer-logo {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin-bottom: var(--space-4);
      text-decoration: none;
      color: white;
    }
    .footer-logo-title {
      font-family: 'Fraunces', serif;
      font-size: var(--text-xl);
      font-weight: 800;
    }

    .footer-description {
      font-size: var(--text-sm);
      line-height: 1.65;
      color: #94A3B8;
      margin-bottom: var(--space-6);
    }

    .footer-social {
      display: flex;
      gap: var(--space-3);
    }
    .footer-social a {
      width: 36px;
      height: 36px;
      border-radius: var(--radius-md);
      background: rgba(255, 255, 255, 0.08);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      text-decoration: none;
      transition: all 0.25s ease;
    }
    .footer-social a:hover {
      background: var(--primary);
      transform: translateY(-2px);
    }

    .footer-column h4 {
      font-size: var(--text-base);
      font-weight: 700;
      margin-bottom: var(--space-4);
      color: white;
    }

    .footer-links {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }

    .footer-links a {
      color: #94A3B8;
      text-decoration: none;
      font-size: var(--text-sm);
      transition: color 0.25s ease;
      display: flex;
      align-items: center;
      gap: var(--space-2);
    }

    .footer-links a:hover {
      color: var(--primary-light);
    }

    .footer-bottom {
      padding-top: var(--space-8);
      border-top: 1px solid #334155;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: var(--text-sm);
      color: #94A3B8;
    }

    .footer-bottom a {
      color: #94A3B8;
      text-decoration: none;
      margin-left: var(--space-4);
      transition: color 0.2s ease;
    }
    .footer-bottom a:hover {
      color: var(--primary-light);
    }

    /* 6. Responsive Design (Ajustes para Tablet y Móvil) */
    @media (max-width: 1024px) {
      .hero-section {
        grid-template-columns: 1fr;
        text-align: center;
        gap: var(--space-12);
        padding: var(--space-8) 0;
      }

      .hero-content {
        max-width: 100%;
      }

      .hero-cta-group {
        justify-content: center;
      }

      .hero-stats {
        justify-content: center;
      }

      .hero-visual {
        order: -1;
      }

      .pwa-section {
        grid-template-columns: 1fr;
        text-align: center;
        padding: var(--space-10) var(--space-6);
      }
      .pwa-features {
        align-items: center;
      }

      .footer-grid {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 768px) {
      .hero-title {
        font-size: var(--text-4xl);
      }

      .hero-stats {
        flex-direction: column;
        gap: var(--space-4);
        align-items: center;
      }

      .products-grid {
        grid-template-columns: 1fr;
      }

      .experience-card {
        grid-template-columns: 1fr;
        padding: var(--space-6);
      }
      .exp-features {
        grid-template-columns: 1fr;
      }

      .footer-grid {
        grid-template-columns: 1fr;
        gap: var(--space-8);
      }

      .footer-bottom {
        flex-direction: column;
        gap: var(--space-4);
        text-align: center;
      }
      .footer-bottom div {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: var(--space-3);
      }
      .footer-bottom a {
        margin-left: 0;
      }

      .award-badge {
        bottom: 10px;
        right: 10px;
        padding: var(--space-2) var(--space-3);
      }
    }

    @media (max-width: 480px) {
      .container {
        padding: 0 var(--space-4);
      }

      .btn-primary, .btn-secondary, .btn-dark {
        width: 100%;
        justify-content: center;
      }

      .menu-filters {
        overflow-x: auto;
        flex-wrap: nowrap;
        padding: var(--space-2) 0;
        -webkit-overflow-scrolling: touch;
        justify-content: flex-start;
      }

      .filter-btn {
        flex-shrink: 0;
        white-space: nowrap;
      }

      .hero-image {
        height: 280px;
      }
    }

    /* Accesibilidad y soporte para reducción de movimiento */
    @media (prefers-reduced-motion: reduce) {
      * {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body>
  <!-- Top Announcement Bar -->
  <div class="top-bar">
    <span>🍔 <strong>HAMBURGER RAPID</strong> — Fast Food Gourmet de Alta Velocidad</span>
    <span>•</span>
    <span>Envío Express garantizado en <span class="highlight">menos de 15 minutos</span> o tu orden es cortesía de la casa</span>
  </div>

  <!-- Navbar -->
  <header class="navbar">
    <div class="container nav-container">
      <a href="/" class="brand-logo" id="nav-brand-logo">
        <div class="brand-icon">🍔</div>
        <div class="brand-text">
          <span class="brand-title">Hamburger Rapid</span>
          <span class="brand-sub">Artisanal Fast Grill</span>
        </div>
      </a>

      <nav class="nav-links">
        <a href="#catalogo">Catálogo (10 Variantes)</a>
        <a href="#especiales">Línea Real</a>
        <a href="#pwa">PWA Móvil</a>
        <a href="#experiencia">Calidad</a>
      </nav>

      <div class="nav-actions">
        <a href="/admin" class="btn-secondary" style="padding: var(--space-2) var(--space-4); font-size: var(--text-sm);">
          📊 Admin
        </a>
        <a href="/app" class="btn-primary" style="padding: var(--space-2) var(--space-5); font-size: var(--text-sm);">
          📱 Pedir en App
        </a>
      </div>
    </div>
  </header>

  <!-- Hero Section Mejorado (Solución de superposición y jerarquía) -->
  <main class="container">
    <section class="hero-section">
      <div class="hero-content">
        <div class="hero-badge">
          <span>👑</span>
          <span>Calidad Suprema • Carne 100% Angus Certificada</span>
        </div>

        <h1 class="hero-title">
          El Sabor del Auténtico<br>
          <span class="highlight">Fast Food Gourmet</span>
        </h1>

        <p class="hero-description">
          Recetas de autor preparadas al instante con fuego vivo, ingredientes nobles y pan brioche horneado cada mañana. Deleita tu paladar con nuestras 10 hamburguesas exclusivas de velocidad real.
        </p>

        <div class="hero-cta-group">
          <a href="#catalogo" class="btn-primary" id="cta-explore-catalog">
            <span>🍔</span>
            Explorar Catálogo (10 Variantes)
          </a>
          <a href="/app" class="btn-secondary" id="cta-pwa-simulate">
            <span>📱</span>
            Simular Compra en PWA
          </a>
        </div>

