  <main>
    <!-- ================= 2. HERO SECTION ================= -->
    <section class="hero-section">
      <div class="container">
        <div class="hero-grid">
          <!-- Left Column: Copy & Actions -->
          <div class="hero-content">
            <div class="hero-script-tag">
              <span>Made Fresh. Made to Crave.</span>
