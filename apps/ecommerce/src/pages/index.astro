<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content="Burger Factory & Hamburger Rapid — 100% fresh beef, bold flavors, crispy hand-cut fries, and thick hand-spun shakes. Burgers done right.">
  <link rel="icon" type="image/svg+xml" href="/app/icon-192.svg">

  <!-- Google Fonts: Bebas Neue (Display Titles), Caveat (Handwritten Doodles & Notes), Plus Jakarta Sans (UI) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Caveat:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      /* Paleta Fiel a la Referencia: Dark Charcoal & Cheddar Amber Gold */
      --bg-dark: #0D0D0D;
      --bg-dark-card: #141414;
      --bg-dark-elevated: #1B1B1B;
      --bg-menu: #F7F7F8;
      --surface-white: #FFFFFF;

      --primary-gold: #F5A623;
      --primary-gold-hover: #E09618;
      --primary-gold-dark: #D97706;
      --primary-gold-light: #FBECCB;

      --text-white: #FFFFFF;
      --text-muted: #9CA3AF;
      --text-dark: #111827;
      --text-dark-muted: #6B7280;

      --border-dark: #242424;
      --border-light: #E5E7EB;

      /* Tipografías */
      --font-display: 'Bebas Neue', sans-serif;
      --font-script: 'Caveat', cursive;
      --font-body: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;

      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 18px;
      --radius-full: 9999px;

      --shadow-card: 0 4px 18px rgba(0, 0, 0, 0.06);
      --shadow-hover: 0 12px 30px rgba(0, 0, 0, 0.12);
      --shadow-gold: 0 6px 20px rgba(245, 166, 35, 0.35);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: var(--font-body);
      background-color: var(--bg-dark);
      color: var(--text-white);
      line-height: 1.5;
      overflow-x: hidden;
    }

    :focus-visible {
      outline: 2px solid var(--primary-gold);
      outline-offset: 3px;
    }

    button:active, .btn-gold:active, .btn-outline:active, .btn-black-add:active {
      transform: scale(0.96) !important;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* ==========================================================================
       1. TOP NAVBAR (Burger Factory Brand Style)
       ========================================================================== */
    header.factory-navbar {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(13, 13, 13, 0.95);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border-dark);
      padding: 16px 0;
    }

    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
    }

    .burger-logo-icon {
      width: 42px;
      height: 42px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 3px;
    }
    .bun-top {
      width: 34px;
      height: 12px;
      background: var(--primary-gold);
      border-top-left-radius: 12px;
      border-top-right-radius: 12px;
    }
    .cheese-meat {
      width: 32px;
      height: 6px;
      background: #FFFFFF;
      border-radius: 3px;
    }
    .bun-bottom {
      width: 34px;
      height: 7px;
      background: var(--primary-gold);
      border-bottom-left-radius: 6px;
      border-bottom-right-radius: 6px;
    }

    .brand-text-block {
      display: flex;
      flex-direction: column;
      line-height: 1;
    }
    .brand-title-line {
      font-family: var(--font-display);
      font-size: 1.55rem;
      letter-spacing: 0.05em;
      color: #FFFFFF;
    }
    .brand-est {
      font-size: 0.65rem;
      letter-spacing: 0.22em;
      color: var(--primary-gold);
      font-weight: 700;
      margin-top: 2px;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 24px;
      list-style: none;
    }
    .nav-links a {
      color: #E5E7EB;
      text-decoration: none;
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      transition: color 0.2s ease;
    }
    .nav-links a:hover,
    .nav-links a.active {
      color: var(--primary-gold);
    }
    .nav-pill-badge {
      background: #222222;
      border: 1px solid #333333;
      padding: 3px 8px;
      border-radius: 999px;
      font-size: 0.68rem;
      color: var(--primary-gold);
      margin-left: 4px;
    }

    .nav-cta-btn {
      background: var(--primary-gold);
      color: #0D0D0D;
      text-decoration: none;
      font-family: var(--font-body);
      font-size: 0.82rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      padding: 10px 20px;
      border-radius: 8px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
      box-shadow: 0 4px 14px rgba(245, 166, 35, 0.25);
    }
    .nav-cta-btn:hover {
      background: var(--primary-gold-hover);
      transform: translateY(-1px);
      box-shadow: var(--shadow-gold);
    }

    /* Mobile hamburger toggle */
    .mobile-nav-toggle {
      display: none;
      background: transparent;
      border: 1px solid var(--border-dark);
      color: #FFFFFF;
      padding: 8px 12px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 1.2rem;
    }

    /* ==========================================================================
       2. HERO SECTION (Burgers Done Right)
       ========================================================================== */
    .hero-section {
      background: var(--bg-dark);
      padding: 50px 0 60px;
      position: relative;
      overflow: hidden;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.95fr;
      align-items: center;
      gap: 40px;
    }

    .hero-content {
      position: relative;
      z-index: 2;
    }

    .hero-script-tag {
      font-family: var(--font-script);
      font-size: 2.1rem;
      font-weight: 700;
      color: var(--primary-gold);
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
    }
    .script-rays {
      font-size: 1.4rem;
      letter-spacing: 2px;
    }

    .hero-title {
      font-family: var(--font-display);
      font-size: 6.2rem;
      line-height: 0.92;
      letter-spacing: 0.02em;
      color: #FFFFFF;
      margin-bottom: 20px;
      text-transform: uppercase;
    }
    .hero-title .highlight-gold {
      color: var(--primary-gold);
    }

    .hero-subtext {
      color: var(--text-muted);
      font-size: 1.05rem;
      line-height: 1.6;
      max-width: 480px;
      margin-bottom: 30px;
    }

    .hero-btn-group {
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 34px;
    }

    .btn-gold {
      background: var(--primary-gold);
      color: #0D0D0D;
      text-decoration: none;
      font-family: var(--font-body);
      font-size: 0.88rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 14px 28px;
      border-radius: 8px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
      box-shadow: 0 4px 16px rgba(245, 166, 35, 0.3);
    }
    .btn-gold:hover {
      background: var(--primary-gold-hover);
      transform: translateY(-2px);
      box-shadow: var(--shadow-gold);
    }

    .btn-outline {
      background: transparent;
      color: #FFFFFF;
      border: 1.5px solid #333333;
      text-decoration: none;
      font-family: var(--font-body);
      font-size: 0.88rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 14px 26px;
      border-radius: 8px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
    }
    .btn-outline:hover {
      border-color: var(--primary-gold);
      color: var(--primary-gold);
      background: rgba(245, 166, 35, 0.05);
    }

    .hero-social-proof {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .stars-row {
      color: var(--primary-gold);
      font-size: 1.15rem;
      letter-spacing: 2px;
    }
    .reviews-label {
      font-size: 0.86rem;
      font-weight: 700;
      color: #E5E7EB;
    }

    /* Hero Image Wrapper & Circular Stamp */
    .hero-image-wrap {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .hero-doodle-top {
      position: absolute;
      top: -24px;
      color: var(--primary-gold);
      font-family: var(--font-script);
      font-size: 2.2rem;
      letter-spacing: 3px;
      z-index: 5;
      pointer-events: none;
    }

    .hero-burger-img {
      width: 100%;
      max-width: 480px;
      height: auto;
      border-radius: 20px;
      filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.8));
      transition: transform 0.4s ease;
    }
    .hero-burger-img:hover {
      transform: scale(1.02);
    }

    /* 100% Fresh Beef Never Frozen Circular Badge */
    .fresh-beef-stamp {
      position: absolute;
      bottom: -10px;
      right: 10px;
      width: 108px;
      height: 108px;
      border-radius: 50%;
      background: #111111;
      border: 2px dashed var(--primary-gold);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
      transform: rotate(6deg);
    }
    .stamp-pct {
      font-family: var(--font-display);
      font-size: 1.25rem;
      line-height: 1;
      color: var(--primary-gold);
    }
    .stamp-title {
      font-family: var(--font-display);
      font-size: 0.82rem;
      line-height: 1;
      color: #FFFFFF;
      letter-spacing: 0.05em;
    }
    .stamp-icon {
      font-size: 0.8rem;
      margin: 2px 0;
    }
    .stamp-sub {
      font-size: 0.52rem;
      font-weight: 800;
      color: var(--primary-gold);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    /* ==========================================================================
       3. QUALITY PILLARS BAR (4 Columns)
       ========================================================================== */
    .pillars-bar {
      background: #141414;
      border-top: 1px solid var(--border-dark);
      border-bottom: 1px solid var(--border-dark);
      padding: 30px 0;
    }
    .pillars-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
    .pillar-item {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .pillar-icon-box {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: #1C1C1C;
      border: 1px solid #2A2A2A;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.6rem;
      flex-shrink: 0;
      color: var(--primary-gold);
    }
    .pillar-text h4 {
      font-family: var(--font-display);
      font-size: 1.2rem;
      letter-spacing: 0.05em;
      color: #FFFFFF;
      line-height: 1.1;
      margin-bottom: 2px;
    }
    .pillar-text p {
      font-size: 0.78rem;
      color: var(--text-muted);
      line-height: 1.35;
    }

    /* ==========================================================================
       4. CUSTOMER FAVORITES (Menu Section)
       ========================================================================== */
    .menu-section {
      background: var(--bg-menu);
      color: var(--text-dark);
      padding: 60px 0 70px;
    }

    .menu-header-row {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 24px;
      flex-wrap: wrap;
    }

    .menu-script-sub {
      font-family: var(--font-script);
      font-size: 2.1rem;
      font-weight: 700;
      color: var(--primary-gold-dark);
      line-height: 1;
    }

    .menu-main-title {
      font-family: var(--font-display);
      font-size: 3.4rem;
      letter-spacing: 0.03em;
      color: #0D0D0D;
      line-height: 0.95;
      text-transform: uppercase;
      margin-top: 4px;
    }

    .gold-title-bar {
      width: 58px;
      height: 4px;
      background: var(--primary-gold);
      border-radius: 2px;
      margin-top: 8px;
    }

    .view-full-menu-btn {
      border: 1.5px solid #0D0D0D;
      background: transparent;
      color: #0D0D0D;
      padding: 10px 20px;
      border-radius: 8px;
      text-decoration: none;
      font-family: var(--font-body);
      font-size: 0.8rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
    }
    .view-full-menu-btn:hover {
      background: #0D0D0D;
      color: #FFFFFF;
    }

    /* Category Filters */
    .filters-row {
      display: flex;
      gap: 10px;
      margin-bottom: 32px;
      overflow-x: auto;
      padding-bottom: 6px;
    }
    .filter-btn {
      padding: 8px 18px;
      border-radius: 999px;
      border: 1px solid var(--border-light);
      background: #FFFFFF;
      color: var(--text-dark-muted);
      font-family: var(--font-body);
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.2s ease;
    }
    .filter-btn:hover {
      border-color: #0D0D0D;
      color: #0D0D0D;
    }
    .filter-btn.active {
      background: #0D0D0D;
      color: #FFFFFF;
      border-color: #0D0D0D;
    }

    /* Cards Grid (Customer Favorites Layout) */
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 22px;
    }

    .favorite-card {
      background: #FFFFFF;
      border-radius: var(--radius-md);
      overflow: hidden;
      border: 1px solid var(--border-light);
      box-shadow: var(--shadow-card);
      display: flex;
      flex-direction: column;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
    }
    .favorite-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-hover);
      border-color: #CBD5E1;
    }

    /* Dark Image Framing as in reference */
    .card-img-frame {
      width: 100%;
      height: 195px;
      background: #0D0D0D;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }
    .card-img-frame img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }
    .favorite-card:hover .card-img-frame img {
      transform: scale(1.06);
    }

    .card-tier-pill {
      position: absolute;
      top: 10px;
      left: 10px;
      background: rgba(13, 13, 13, 0.85);
      backdrop-filter: blur(8px);
      color: var(--primary-gold);
      font-size: 0.64rem;
      font-weight: 800;
      padding: 3px 8px;
      border-radius: 999px;
      border: 1px solid rgba(245, 166, 35, 0.3);
      letter-spacing: 0.04em;
    }

    .card-body {
      padding: 16px 18px 18px;
      display: flex;
      flex-direction: column;
      flex: 1;
      justify-content: space-between;
    }

    .card-burger-title {
      font-family: var(--font-display);
      font-size: 1.4rem;
      letter-spacing: 0.03em;
      color: #0D0D0D;
      line-height: 1.1;
      margin-bottom: 6px;
      text-transform: uppercase;
    }

    .card-ingredients-text {
      color: var(--text-dark-muted);
      font-size: 0.8rem;
      line-height: 1.45;
      margin-bottom: 16px;
      flex: 1;
    }

    .card-footer-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 8px;
      border-top: 1px solid #F1F5F9;
    }

    .card-price {
      font-family: var(--font-display);
      font-size: 1.7rem;
      color: var(--primary-gold-dark);
      font-weight: 800;
      letter-spacing: 0.02em;
      line-height: 1;
    }

    .btn-black-add {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: #0D0D0D;
      color: #FFFFFF;
      border: none;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.15rem;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    }
    .btn-black-add:hover {
      background: var(--primary-gold);
      color: #0D0D0D;
      transform: scale(1.08);
    }

    /* ==========================================================================
       5. SPLIT PROMOTIONAL BANNER (Meal Combo & Burgers Built on Passion)
       ========================================================================== */
    .split-promo-section {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    /* Left Half: Dark Charcoal Meal Combo */
    .meal-combo-half {
      background: #0D0D0D;
      padding: 50px 40px;
      display: flex;
      align-items: center;
      gap: 30px;
      position: relative;
      border-right: 1px solid #222222;
    }
    .meal-img-box {
      width: 45%;
      position: relative;
    }
    .meal-burger-img {
      width: 100%;
      height: auto;
      border-radius: 14px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    }
    .meal-content-box {
      width: 55%;
    }
    .meal-script {
      font-family: var(--font-script);
      font-size: 2rem;
      color: var(--primary-gold);
      line-height: 1;
    }
    .meal-title {
      font-family: var(--font-display);
      font-size: 4.8rem;
      color: #FFFFFF;
      line-height: 0.92;
      margin-bottom: 6px;
    }
    .meal-subtext {
      color: #E5E7EB;
      font-size: 0.95rem;
      font-weight: 600;
      margin-bottom: 4px;
    }
    .meal-price-tag {
      font-family: var(--font-display);
      font-size: 3.5rem;
      color: var(--primary-gold);
      line-height: 1;
      margin-bottom: 18px;
    }
    .meal-cta-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--primary-gold);
      color: #0D0D0D;
      padding: 10px 18px;
      border-radius: 8px;
      font-size: 0.8rem;
      font-weight: 800;
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      transition: all 0.2s ease;
    }
    .meal-cta-btn:hover {
      background: #FFFFFF;
    }

    /* Right Half: Cheddar Amber Gold About Section */
    .passion-about-half {
      background: var(--primary-gold);
      color: #0D0D0D;
      padding: 50px 40px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 30px;
      position: relative;
    }
    .passion-content-box {
      max-width: 360px;
    }
    .passion-script {
      font-family: var(--font-script);
      font-size: 2rem;
      color: #0D0D0D;
      line-height: 1;
      margin-bottom: 4px;
    }
    .passion-title {
      font-family: var(--font-display);
      font-size: 3.6rem;
      color: #0D0D0D;
      line-height: 0.95;
      text-transform: uppercase;
      margin-bottom: 12px;
    }
    .passion-paragraph {
      color: #262626;
      font-size: 0.88rem;
      line-height: 1.5;
      margin-bottom: 22px;
      font-weight: 600;
    }
    .btn-story-black {
      background: #0D0D0D;
      color: #FFFFFF;
      padding: 12px 24px;
      border-radius: 6px;
      text-decoration: none;
      font-family: var(--font-body);
      font-size: 0.84rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
    }
    .btn-story-black:hover {
      background: #222222;
      transform: translateX(3px);
    }

    /* Circular Spatula Stamp Graphic */
    .passion-stamp-graphic {
      width: 130px;
      height: 130px;
      border-radius: 50%;
      border: 2px dashed #0D0D0D;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      flex-shrink: 0;
      transform: rotate(-8deg);
      padding: 8px;
    }
    .stamp-utensils {
      font-size: 1.8rem;
      margin: 2px 0;
    }
    .stamp-text-arc {
      font-family: var(--font-display);
      font-size: 0.76rem;
      color: #0D0D0D;
      letter-spacing: 0.06em;
      line-height: 1.1;
    }
    .stamp-script-bottom {
      font-family: var(--font-script);
      font-size: 1.35rem;
      color: #0D0D0D;
      font-weight: 700;
      line-height: 1;
    }

    /* ==========================================================================
       6. MONOREPO PWA SHOWCASE BANNER
       ========================================================================== */
    .pwa-showcase-section {
      background: #111111;
      border-top: 1px solid var(--border-dark);
      border-bottom: 1px solid var(--border-dark);
      padding: 60px 0;
    }
    .pwa-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 40px;
    }
    .pwa-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(245, 166, 35, 0.12);
      border: 1px solid rgba(245, 166, 35, 0.3);
      color: var(--primary-gold);
      padding: 4px 12px;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 800;
      margin-bottom: 14px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .pwa-title {
      font-family: var(--font-display);
      font-size: 3.4rem;
      color: #FFFFFF;
      line-height: 0.95;
      margin-bottom: 14px;
      text-transform: uppercase;
    }
    .pwa-features-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 26px;
    }
    .pwa-features-list li {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 0.9rem;
      color: #E5E7EB;
    }
    .pwa-features-list li span.check {
      color: var(--primary-gold);
      font-weight: 800;
    }

    .pwa-card-preview {
      background: #1A1A1A;
      border: 1px solid #2B2B2B;
      border-radius: 24px;
      padding: 30px;
      display: flex;
      flex-direction: column;
      gap: 20px;
      box-shadow: 0 15px 35px rgba(0,0,0,0.5);
    }
    .preview-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid #262626;
      padding-bottom: 14px;
    }
    .preview-pills {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
    }
    .preview-pill {
      background: #242424;
      border-radius: 12px;
      padding: 10px 4px;
      text-align: center;
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--text-muted);
    }
    .preview-pill.active {
      background: var(--primary-gold);
      color: #0D0D0D;
      font-weight: 800;
    }

    /* ==========================================================================
       7. INTERACTIVE MODAL (Detail View)
       ========================================================================== */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(8px);
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      opacity: 0;
      visibility: hidden;
      transition: all 0.25s ease;
    }
    .modal-backdrop.open {
      opacity: 1;
      visibility: visible;
    }
    .modal-box {
      background: #141414;
      border: 1px solid #2B2B2B;
      color: #FFFFFF;
      width: 100%;
      max-width: 560px;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7);
      transform: scale(0.95);
      transition: transform 0.25s ease;
      position: relative;
    }
    .modal-backdrop.open .modal-box {
      transform: scale(1);
    }
    .modal-img-wrap {
      width: 100%;
      height: 230px;
      background: #090909;
      position: relative;
    }
    .modal-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .modal-close-btn {
      position: absolute;
      top: 14px;
      right: 14px;
      background: rgba(0, 0, 0, 0.75);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #FFFFFF;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 0.9rem;
    }
    .modal-content-pad {
      padding: 22px 26px 26px;
    }
    .modal-tag {
      background: rgba(245, 166, 35, 0.15);
      color: var(--primary-gold);
      font-size: 0.72rem;
      font-weight: 800;
      padding: 3px 10px;
      border-radius: 999px;
      display: inline-block;
      margin-bottom: 8px;
    }
    .modal-title-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 8px;
    }
    .modal-burger-name {
      font-family: var(--font-display);
      font-size: 2.2rem;
      color: #FFFFFF;
      letter-spacing: 0.03em;
    }
    .modal-burger-price {
      font-family: var(--font-display);
      font-size: 2.2rem;
      color: var(--primary-gold);
    }
    .modal-desc {
      color: var(--text-muted);
      font-size: 0.88rem;
      line-height: 1.5;
      margin-bottom: 16px;
    }
    .modal-ingredients-wrap {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 16px;
    }
    .ingredient-badge {
      background: #202020;
      border: 1px solid #2F2F2F;
      color: #E5E7EB;
      font-size: 0.76rem;
      padding: 4px 10px;
      border-radius: 6px;
    }
    .chef-pairing-box {
      background: #1B1B1B;
      border: 1px solid #2B2B2B;
      border-radius: 10px;
      padding: 12px 14px;
      font-size: 0.8rem;
      color: #D1D5DB;
      margin-bottom: 22px;
    }
    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 12px;
    }

    /* ==========================================================================
       8. FOOTER (Exact Match to Reference Layout)
       ========================================================================== */
    footer.factory-footer {
      background: #0D0D0D;
      border-top: 1px solid var(--border-dark);
      padding: 60px 0 30px;
      color: #FFFFFF;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.3fr 1fr 1.3fr 1.4fr;
      gap: 36px;
      margin-bottom: 40px;
    }

    .footer-col-title {
      font-family: var(--font-body);
      font-size: 0.82rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #FFFFFF;
      margin-bottom: 18px;
    }

    .footer-brand-p {
      color: var(--text-muted);
      font-size: 0.82rem;
      line-height: 1.6;
      max-width: 260px;
      margin-top: 14px;
    }

    .footer-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .footer-list a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.84rem;
      transition: color 0.2s ease;
    }
    .footer-list a:hover {
      color: var(--primary-gold);
    }

    .hours-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.82rem;
      color: var(--text-muted);
    }
    .hours-table td {
      padding: 4px 0;
    }
    .hours-table td.time {
      text-align: right;
      color: #FFFFFF;
      font-weight: 600;
    }

    .social-icons-row {
      display: flex;
      gap: 12px;
      margin-bottom: 18px;
    }
    .social-btn {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: #1C1C1C;
      border: 1px solid #2B2B2B;
      color: #FFFFFF;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      font-size: 0.95rem;
      transition: all 0.2s ease;
    }
    .social-btn:hover {
      background: var(--primary-gold);
      color: #0D0D0D;
      border-color: var(--primary-gold);
    }

    /* Order Ahead & Skip the Line Box */
    .order-ahead-card {
      background: #141414;
      border: 1px dashed rgba(245, 166, 35, 0.4);
      border-radius: 12px;
      padding: 12px 14px;
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      transition: all 0.2s ease;
    }
    .order-ahead-card:hover {
      border-color: var(--primary-gold);
      background: #1A1A1A;
    }
    .order-ahead-icon {
      font-size: 1.4rem;
      color: var(--primary-gold);
    }
    .order-ahead-text {
      flex: 1;
    }
    .order-ahead-label {
      font-size: 0.65rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--text-muted);
    }
    .order-ahead-action {
      font-family: var(--font-display);
      font-size: 1.15rem;
      color: var(--primary-gold);
      letter-spacing: 0.04em;
      line-height: 1;
    }

    .footer-copyright-bar {
      border-top: 1px solid var(--border-dark);
      padding-top: 24px;
      text-align: center;
      font-size: 0.76rem;
      color: #6B7280;
    }

    /* ==========================================================================
       RESPONSIVE BREAKPOINTS
       ========================================================================== */
    @media (max-width: 1024px) {
      .hero-grid {
        grid-template-columns: 1fr;
        text-align: center;
        gap: 30px;
      }
      .hero-subtext {
        margin: 0 auto 30px;
      }
      .hero-btn-group, .hero-social-proof {
        justify-content: center;
      }
      .pillars-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .cards-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .split-promo-section {
        grid-template-columns: 1fr;
      }
      .meal-combo-half {
        border-right: none;
        border-bottom: 1px solid #222222;
      }
      .footer-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 768px) {
      .nav-links {
        display: none;
      }
      .mobile-nav-toggle {
        display: block;
      }
      .hero-title {
        font-size: 4rem;
      }
      .cards-grid {
        grid-template-columns: 1fr;
      }
      .pillars-grid {
        grid-template-columns: 1fr;
      }
      .pwa-grid {
        grid-template-columns: 1fr;
      }
      .meal-combo-half {
        flex-direction: column;
        text-align: center;
      }
      .meal-img-box, .meal-content-box {
        width: 100%;
      }
      .passion-about-half {
        flex-direction: column;
        text-align: center;
      }
      .passion-content-box {
        max-width: 100%;
      }
      .footer-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
